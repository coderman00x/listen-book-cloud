# 听书宝 v2.0 环境变量模板
# 用法：cp .env.example .env，按需修改后 docker compose up -d --build
# 注意：.env 含访问口令，已被 .dockerignore 排除，切勿提交到公开仓库。

# 容器内 uvicorn 监听端口（Render / Cloud Run 由平台自动注入；Compose 从本文件读取）
PORT=8000

# 宿主映射端口（仅 docker-compose 使用；默认 8000）
HOST_PORT=8000

# 访问口令：公网部署【必填】。留空 = 不启用口令，仅建议在可信局域网使用；
# 公网模式留空时 /api/health 会额外返回 warning 提示。
ACCESS_TOKEN=

# 公网模式开关：1 / true / yes / on 开启（大小写不敏感）。
# 开启后「手机访问」面板显示公网 HTTPS 地址、隐藏容器内网 IP 与二维码；
# 0 = 局域网模式，保持 v1.4 旧版行为不变。
LISTENBOOK_PUBLIC=0

# 公网 HTTPS 地址（结尾不要带斜杠），如 https://listen-book.onrender.com
# 留空时前端回退使用当前页面地址 window.location.origin。
LISTENBOOK_PUBLIC_URL=

# app 自身数据目录（红线：后端只读写该目录，绝不访问用户原始 txt/epub/pdf）。
# 容器内固定为 /app/data 并挂载卷；本地运行留空即默认 <项目根>/data，行为不变。
LISTENBOOK_DATA_DIR=

# 监听地址：容器 / 公网固定 0.0.0.0（不可改成 127.0.0.1，否则外部连不上）
LISTENBOOK_HOST=0.0.0.0

# 构建期国内镜像源：国内 VPS 构建慢时改为 1（切换清华 apt/pip + npmmirror npm 源）；Render/HF 等海外平台保持 0
# 仅影响构建期换源，不影响运行期；默认 0 = 官方源，行为不变
USE_CN_MIRROR=0
